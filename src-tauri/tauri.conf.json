{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.1.1",
  "identifier": "com.redrecords.pulse",
  "build": {
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pulse",
        "url": "launch.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "pulse"
        ],
        "name": "Projet Pulse",
        "description": "Projet Pulse",
        "role": "Editor",
        "mimeType": "application/x-pulse"
      }
    ]
  }
}
