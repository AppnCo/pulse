{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pulse : fenêtre principale",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "allow-native-info",
    "allow-native-play", "allow-native-play-staged", "allow-stage-put", "allow-save-file-staged", "allow-save-download-staged", "allow-read-file-part", "allow-project-file-size", "allow-web-update", "allow-migration-state", "allow-migration-put", "allow-migration-read", "allow-migration-done",
    "allow-native-play-project",
    "allow-native-mix", "allow-native-swap", "allow-native-loop", "allow-native-live", "allow-native-scope", "allow-diag-write",
    "allow-native-stop",
    "allow-monitor-start",
    "allow-monitor-stop",
    "allow-monitor-gain",
    "allow-monitor-track",
    "allow-monitor-info",
    "allow-midi-ports",
    "allow-midi-start",
    "allow-pick-folder",
    "allow-create-project-folder",
    "allow-project-folder-ok",
    "allow-save-file",
    "allow-reveal-project-folder",
    "allow-take-pending-open",
    "allow-read-pulse-file",
    "allow-import-url",
    "allow-read-import-file",
    "allow-test-log",
    "allow-test-exit",
    "allow-save-download"
  ],
  "remote": {
    "urls": [
      "https://appnco.app/*"
    ]
  }
}